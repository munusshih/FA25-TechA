---
import type { AstroComponentFactory } from "astro";
import Nav from "../components/Nav.astro";

export interface Props {
  title?: string;
  programUrl?: string;
  programLabelMobile?: string;
  programLabelDesktop?: string;
  courseCode?: string;
  navComponent?: AstroComponentFactory;
}

const {
  title = "Graduate Studio: Technology A",
  programUrl = "https://www.pratt.edu/design/graduate-communications-design/",
  programLabelMobile = "Pratt Grad ComD MFA",
  programLabelDesktop = "Pratt Grad ComD",
  courseCode = "DES 720A",
  navComponent,
} = Astro.props;

const NavComponent = navComponent ?? Nav;
const hasTitleSlot = Astro.slots.has("title");
const hasNavSlot = Astro.slots.has("nav");
const hasMobileMetaSlot = Astro.slots.has("mobile-meta");
const hasDesktopMetaSlot = Astro.slots.has("desktop-meta");
const hasDefaultSlot = Astro.slots.has("default");
const hasExtraSlot = Astro.slots.has("extra");
---

<header
  data-header-root
  class="items-top flex w-full flex-col justify-between gap-4 py-[var(--margin)] text-pretty transition-transform duration-300 will-change-transform"
>
  <div class="cutoff flex flex-row justify-between">
    <div
      class="flex w-max flex-row items-center justify-between gap-2 md:flex-col md:items-start"
    >
      <div class="flex flex-col gap-4 md:gap-2">
        {
          hasTitleSlot ? (
            <slot name="title" />
          ) : (
            <h1 class="heading-1 w-auto text-balance" data-header-scale>
              {title}
            </h1>
          )
        }
        <div class="mt-4 flex flex-row gap-4 md:hidden">
          {
            hasMobileMetaSlot ? (
              <slot name="mobile-meta" />
            ) : (
              <>
                <h2 data-header-scale>
                  <a href={programUrl}>{programLabelMobile}</a>
                </h2>
                <h2 data-header-scale>{courseCode}</h2>
              </>
            )
          }
        </div>
      </div>
      <div class="flex-shrink-0">
        {
          hasNavSlot ? (
            <slot name="nav" />
          ) : hasDefaultSlot ? (
            <slot />
          ) : (
            <NavComponent />
          )
        }
      </div>
    </div>
    <div class="hidden md:block">
      {
        hasDesktopMetaSlot ? (
          <slot name="desktop-meta" />
        ) : (
          <>
            <h2 data-header-scale>
              <a href={programUrl}>{programLabelDesktop}</a>
            </h2>
            <h2 data-header-scale>{courseCode}</h2>
          </>
        )
      }
    </div>
  </div>
  {hasExtraSlot ? <slot name="extra" /> : null}
</header>

<script>
  import { gsap } from "gsap";

  const setupHeader = (header) => {
    const elements = header.querySelectorAll(
      "[data-header-scale], .clock-container",
    );

    if (elements.length === 0) return;

    const getScrollY = () => window.scrollY || window.pageYOffset;
    let lastScrollY = getScrollY();
    let ticking = false;

    function getHeaderBounds() {
      const top = header.offsetTop;
      const height = header.offsetHeight;
      const bottom = top + height;
      return { top, height, bottom };
    }

    function updateFontScale() {
      const scrollY = getScrollY();
      const { top, bottom } = getHeaderBounds();

      let scale;
      if (scrollY <= top) {
        scale = 1;
      } else if (scrollY >= bottom) {
        scale = 0.3;
      } else {
        const progress = (scrollY - top) / (bottom - top);
        scale = 1 - 0.7 * progress;
      }

      elements.forEach((el) => {
        gsap.set(el, { "--font-scale": scale });
      });
    }

    function updateHeaderVisibility(scrollY, direction) {
      const { height, bottom } = getHeaderBounds();
      const hideThreshold = bottom + height * 2;

      if (scrollY >= hideThreshold && direction === 1) {
        header.classList.add("-translate-y-full");
      } else if (direction === -1) {
        header.classList.remove("-translate-y-full");
      }
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = getScrollY();
          const direction = scrollY > lastScrollY ? 1 : -1;

          updateFontScale();
          updateHeaderVisibility(scrollY, direction);

          lastScrollY = Math.max(scrollY, 0);
          ticking = false;
        });

        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll);
    window.addEventListener("resize", updateFontScale);
    window.addEventListener("load", () => {
      updateFontScale();
      const scrollY = getScrollY();
      updateHeaderVisibility(scrollY, 1);
    });
  };

  document.addEventListener("DOMContentLoaded", () => {
    document
      .querySelectorAll("[data-header-root]")
      .forEach((header) => setupHeader(header));
  });
</script>
