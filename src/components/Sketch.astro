---
import {
  projectsWithMeta,
  currentYearProjects,
  getProjectAuthor,
  getProjectTitle,
  getPrimaryMediaEntry,
} from "@/lib/projects.js";

// Show the current year on the homepage; fall back to all years
// during the transition before a new year has been synced.
const sketchProjects = currentYearProjects.length
  ? currentYearProjects
  : projectsWithMeta;

const allProjects = sketchProjects
  .map((project) => {
    const primaryMedia = getPrimaryMediaEntry(project);
    if (!primaryMedia || !primaryMedia.value) return null;
    return {
      url: primaryMedia.value,
      type: primaryMedia.type === "video" ? "video" : "image",
      name: getProjectAuthor(project),
      title: getProjectTitle(project),
      slug: project.slug,
    };
  })
  .filter(Boolean);

const initialProject = allProjects[0];
---

<div
  id="student-work-banner"
  class="sketch-wrapper ridge-border cutoff"
  aria-label="Featured student work"
>
  <div id="banner-media" class="sketch-media">
    {
      initialProject?.type === "video" ? (
        <video
          src={initialProject.url}
          aria-label={`${initialProject.title} by ${initialProject.name}`}
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
        />
      ) : initialProject ? (
        <img
          src={initialProject.url}
          alt={`${initialProject.title} by ${initialProject.name}`}
          decoding="async"
        />
      ) : null
    }
  </div>
</div>
<div id="student-name" class="student-name cutoff">
  <a
    id="project-link"
    href={initialProject ? `/work/${initialProject.slug}/` : "/work"}
    >{
      initialProject
        ? `${initialProject.title}, ${initialProject.name}`
        : "View student work"
    }</a
  >
</div>

<script define:vars={{ bannerProjects: allProjects }}>
  const projects = bannerProjects;

  function shuffleArray(array) {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  function createMedia(project) {
    return new Promise((resolve, reject) => {
      if (!project) {
        reject(new Error("Missing student project"));
        return;
      }

      const timeout = window.setTimeout(
        () => reject(new Error("Student media timed out")),
        10000,
      );
      const loaded = (media) => {
        window.clearTimeout(timeout);
        resolve(media);
      };
      const failed = (error) => {
        window.clearTimeout(timeout);
        reject(error);
      };

      if (project.type === "video") {
        const video = document.createElement("video");
        video.muted = true;
        video.loop = true;
        video.autoplay = true;
        video.playsInline = true;
        video.preload = "auto";
        video.setAttribute("aria-label", `${project.title} by ${project.name}`);
        video.addEventListener("loadeddata", () => loaded(video), {
          once: true,
        });
        video.addEventListener("error", failed, { once: true });
        video.src = project.url;
        video.load();
        return;
      }

      const image = new Image();
      image.decoding = "async";
      image.alt = `${project.title} by ${project.name}`;
      image.addEventListener(
        "load",
        async () => {
          try {
            await image.decode();
          } catch {
            // A loaded image is still safe to display if decode() is rejected.
          }
          loaded(image);
        },
        { once: true },
      );
      image.addEventListener("error", failed, { once: true });
      image.src = project.url;
    });
  }

  function setupBanner() {
    const banner = document.getElementById("student-work-banner");
    const mediaContainer = document.getElementById("banner-media");
    const nameElement = document.getElementById("student-name");
    const linkElement = document.getElementById("project-link");

    if (
      !banner ||
      !mediaContainer ||
      !nameElement ||
      !linkElement ||
      projects.length < 2
    ) {
      return;
    }

    const allIndices = Array.from({ length: projects.length }, (_, i) => i);
    let currentProjectIndex = 0;
    let queue = shuffleArray(allIndices.filter((index) => index !== 0));
    let timer;
    let isLoading = false;
    let isPaused = false;

    const refillQueue = () => {
      queue = shuffleArray(
        allIndices.filter((index) => index !== currentProjectIndex),
      );
    };

    const scheduleNext = (delay = 8000) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (isPaused || document.hidden) {
          scheduleNext(1000);
          return;
        }
        showNextProject();
      }, delay);
    };

    const loadNextProject = async () => {
      const attempted = new Set();

      while (attempted.size < projects.length - 1) {
        if (queue.length === 0) refillQueue();
        const projectIndex = queue.shift();
        if (projectIndex === undefined || attempted.has(projectIndex)) continue;
        attempted.add(projectIndex);

        const project = projects[projectIndex];
        try {
          const media = await createMedia(project);
          return { media, project, projectIndex };
        } catch {
          // Skip unavailable media and keep looking for a valid project.
        }
      }

      return null;
    };

    async function showNextProject() {
      if (isLoading) return;
      isLoading = true;

      const next = await loadNextProject();
      if (!next) {
        isLoading = false;
        scheduleNext();
        return;
      }

      const outgoingVideo = mediaContainer.querySelector("video");
      if (outgoingVideo) outgoingVideo.pause();

      mediaContainer.replaceChildren(next.media);
      linkElement.href = `/work/${next.project.slug}/`;
      linkElement.textContent = `${next.project.title}, ${next.project.name}`;

      if (next.media instanceof HTMLVideoElement) {
        next.media.play().catch(() => {});
      }

      currentProjectIndex = next.projectIndex;
      isLoading = false;
      scheduleNext();
    }

    const pause = () => {
      isPaused = true;
    };
    const resume = () => {
      isPaused = false;
      if (!isLoading) scheduleNext(1200);
    };

    [banner, nameElement].forEach((element) => {
      element.addEventListener("pointerenter", pause);
      element.addEventListener("pointerleave", resume);
    });
    nameElement.addEventListener("focusin", pause);
    nameElement.addEventListener("focusout", resume);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden && !isLoading) scheduleNext(1200);
    });

    scheduleNext();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupBanner, { once: true });
  } else {
    setupBanner();
  }
</script>
